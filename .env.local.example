# Local CMS testing - use a disposable, isolated Supabase project only.
# Do not copy production credentials or production client data into local tests.
NEXT_PUBLIC_SUPABASE_URL=https://your-isolated-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-isolated-project-anon-key

# Server-only key for isolated-project admin/storage workflows, if required.
# Never use a production service-role key here or expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-isolated-project-service-role-key
